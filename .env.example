# 存储驱动：local（默认，写项目内 .data/）或 blob（Vercel Blob）
# 未设置时：有 BLOB_READ_WRITE_TOKEN 就用 blob，否则 local
STORAGE_DRIVER=local

# Vercel Blob（Dashboard → Storage → Blob 连接项目后自动注入）
BLOB_READ_WRITE_TOKEN=

# 后台 /admin —— 生产环境强制要求
#
# 生产环境（Vercel 或 NODE_ENV=production）下，这两个变量是必需的：
#   - 缺失 / 等于下面的默认值 / 长度不足 → 后台登录返回 503 ADMIN_NOT_CONFIGURED
#   - ADMIN_PASSWORD 至少 8 位，ADMIN_SECRET 至少 16 位
#
# 本地开发（NODE_ENV 未设为 production）不受限制，默认值可直接用于本地调试。
#
# 生成强密钥：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_PASSWORD=inaue-admin
ADMIN_SECRET=change-this-to-a-long-random-string

# 商品数据源：mock（默认）或 shopify
COMMERCE_PROVIDER=mock
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_API_VERSION=2025-01
